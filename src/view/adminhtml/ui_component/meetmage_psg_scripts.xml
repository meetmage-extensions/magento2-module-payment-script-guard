<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">meetmage_psg_scripts.meetmage_psg_scripts_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="check_all">
                <url path="*/*/checkAll"/>
                <class>secondary</class>
                <label translate="true">Check Integrity Now</label>
            </button>
            <button name="export">
                <url path="*/*/export"/>
                <class>primary</class>
                <label translate="true">Download PCI Report (CSV)</label>
            </button>
        </buttons>
        <spinner>meetmage_psg_script_columns</spinner>
        <deps>
            <dep>meetmage_psg_scripts.meetmage_psg_scripts_source</dep>
        </deps>
    </settings>
    <dataSource name="meetmage_psg_scripts_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">script_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>MeetMage_PaymentScriptGuard::inventory</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="meetmage_psg_scripts_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>script_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="authorize">
                <settings>
                    <confirm>
                        <message translate="true">Authorize the selected scripts with the bulk justification?</message>
                        <title translate="true">Authorize scripts</title>
                    </confirm>
                    <url path="meetmage_psg/script/massAuthorize"/>
                    <type>authorize</type>
                    <label translate="true">Authorize</label>
                </settings>
            </action>
            <action name="reject">
                <settings>
                    <confirm>
                        <message translate="true">Reject the selected scripts?</message>
                        <title translate="true">Reject scripts</title>
                    </confirm>
                    <url path="meetmage_psg/script/massReject"/>
                    <type>reject</type>
                    <label translate="true">Reject</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="meetmage_psg_script_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>script_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="script_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select" sortOrder="20">
            <settings>
                <options class="MeetMage\PaymentScriptGuard\Model\Source\Status"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="type" component="Magento_Ui/js/grid/columns/select" sortOrder="30">
            <settings>
                <options class="MeetMage\PaymentScriptGuard\Model\Source\ScriptType"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Type</label>
            </settings>
        </column>
        <column name="label" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Script</label>
            </settings>
        </column>
        <column name="host" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">Host</label>
            </settings>
        </column>
        <column name="first_party" component="Magento_Ui/js/grid/columns/select" sortOrder="60">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">First-party</label>
            </settings>
        </column>
        <column name="integrity_status" component="Magento_Ui/js/grid/columns/select" sortOrder="70">
            <settings>
                <options class="MeetMage\PaymentScriptGuard\Model\Source\IntegrityStatus"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Integrity</label>
            </settings>
        </column>
        <column name="justification" sortOrder="80">
            <settings>
                <filter>text</filter>
                <label translate="true">Justification</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="pages" sortOrder="90">
            <settings>
                <label translate="true">Pages</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="seen_count" sortOrder="100">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Times Seen</label>
            </settings>
        </column>
        <column name="first_seen_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="110">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">First Seen</label>
            </settings>
        </column>
        <column name="last_seen_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="120">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Last Seen</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="MeetMage\PaymentScriptGuard\Ui\Component\Listing\Column\ReviewAction"
                       sortOrder="200">
            <settings>
                <indexField>script_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>

<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::system">
                    <resource id="MeetMage_PaymentScriptGuard::guard" title="Payment Script Guard"
                              translate="title" sortOrder="60">
                        <resource id="MeetMage_PaymentScriptGuard::inventory" title="View Script Inventory"
                                  translate="title" sortOrder="10"/>
                        <resource id="MeetMage_PaymentScriptGuard::authorize" title="Authorize or Reject Scripts"
                                  translate="title" sortOrder="20"/>
                        <resource id="MeetMage_PaymentScriptGuard::activity" title="View Activity Log"
                                  translate="title" sortOrder="30"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="MeetMage_PaymentScriptGuard::config"
                                      title="MeetMage Payment Script Guard"
                                      translate="title"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>

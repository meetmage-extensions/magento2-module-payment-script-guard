{
    "name": "meetmage/module-payment-script-guard",
    "description": "PCI DSS 4.0.1 payment page script inventory (6.4.3) and tamper detection (11.6.1) for Magento 2, with Hyvä and Luma support.",
    "type": "magento2-module",
    "license": "MIT",
    "keywords": [
        "magento2",
        "magento",
        "adobe-commerce",
        "hyva",
        "pci-dss",
        "magecart",
        "csp",
        "sri",
        "security",
        "payment-script-guard"
    ],
    "authors": [
        {
            "name": "Meet Shekhat",
            "email": "meetshekhat1988@gmail.com",
            "homepage": "https://meetshekhat.com"
        }
    ],
    "homepage": "https://github.com/meetmage-extensions/magento2-module-payment-script-guard",
    "support": {
        "issues": "https://github.com/meetmage-extensions/magento2-module-payment-script-guard/issues",
        "source": "https://github.com/meetmage-extensions/magento2-module-payment-script-guard"
    },
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0",
        "magento/module-store": "*",
        "magento/module-config": "*",
        "magento/module-backend": "*",
        "magento/module-ui": "*",
        "magento/module-cron": "*",
        "magento/module-email": "*",
        "magento/module-csp": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.12",
        "bitexpert/phpstan-magento": "^0.32",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "MeetMage\\PaymentScriptGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MeetMage\\PaymentScriptGuard\\Test\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": false,
            "magento/magento-composer-installer": false,
            "phpstan/extension-installer": true,
            "laminas/laminas-dependency-plugin": false
        }
    }
}
